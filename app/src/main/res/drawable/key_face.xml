<?xml version="1.0" encoding="utf-8"?>
<!--
  A Stream Deck key face: dark fill, rounded corners, thin border.

  Why a drawable rather than a plain Button: the default Android button is a
  bordered rectangle with a shadow, which reads as "form control". The physical
  deck's keys are matte rounded squares, and the whole point of this grid is that
  it looks like the hardware in the user's hand, so a screen key in the same
  position is instantly the same thing.

  The radius is generous (18% of a 90dp key) but not a pill: a real key has a
  soft corner, not a stadium edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="#2A2F3A" />
    <stroke android:width="1dp" android:color="#3A404E" />
</shape>
