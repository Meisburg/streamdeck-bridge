<?xml version="1.0" encoding="utf-8"?>
<!--
  Stream Deck key-grid mark.

  Drawn rather than bundled: this is the hardware's 5x3 key layout, authored here
  as paths. It reads as the deck without shipping an Elgato asset, which would be
  their trademark. The grid motif is the physical thing the user is holding.

  Colour is a fixed brand blue rather than a theme role, because a logo is a
  brand mark and should not change with dark mode. It holds up on both: the blue
  is mid-tone, so it clears contrast against a light background and against the
  dark #101418 the rest of this app uses.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Outer rounded square: the deck body. -->
    <path
        android:fillColor="#2F6FED"
        android:pathData="M8,4 h32 a4,4 0 0 1 4,4 v32 a4,4 0 0 1 -4,4 h-32 a4,4 0 0 1 -4,-4 v-32 a4,4 0 0 1 4,-4 z" />

    <!--
      The 5x3 key grid. Each key is a rounded square. Positions are laid out on
      a 5-column pitch of 7 units and a 3-row pitch of 10, which is what makes the
      mark read as a keypad rather than a generic dot grid.
    -->
    <group>
        <!-- row 1 -->
        <path android:fillColor="#FFFFFF" android:pathData="M10,10 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M17,10 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M24,10 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M31,10 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M38,10 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />

        <!-- row 2 -->
        <path android:fillColor="#FFFFFF" android:pathData="M10,20 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M17,20 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M24,20 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M31,20 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M38,20 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z" />

        <!-- row 3 -->
