<?xml version="1.0" encoding="utf-8"?>
<!--
  An empty key face: same rounded square, but dimmer and with a dashed border.

  Why distinct from key_face.xml: the user asked that a key stay on the grid even
  when its command is cleared. It has to remain obviously a key you can fill
  rather than looking broken, so it keeps the identical geometry and loses only
  its weight.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="#1A1E26" />
    <stroke
        android:width="1dp"
        android:color="#333A47"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
</shape>
